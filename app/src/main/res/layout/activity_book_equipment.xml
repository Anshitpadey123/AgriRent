<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/bookingBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="  Back"
            android:textColor="#198754"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Book Equipment"
            android:textColor="#183B25"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#E1F0E3"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/bookingEquipmentEmoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🚜"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/bookingEquipmentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tractor"
                android:textColor="#183B25"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookingEquipmentCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tractor • Mathura"
                android:textColor="#526653"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bookingDailyPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="₹1200 / day"
                android:textColor="#198754"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Rental Dates"
            android:textColor="#183B25"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startDateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFFFFF"
            android:text="Select Start Date"
            android:textAllCaps="false"
            android:textColor="#198754" />

        <Button
            android:id="@+id/endDateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFFFFF"
            android:text="Select End Date"
            android:textAllCaps="false"
            android:textColor="#198754" />

        <TextView
            android:id="@+id/rentalDaysText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Rental duration: 0 days"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Farmer Details"
            android:textColor="#183B25"
            android:textSize="19sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/farmerNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/farmerPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:hint="10-digit contact number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="12dp"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E1F0E3"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated Total"
                android:textColor="#526653"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/bookingTotalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="₹0"
                android:textColor="#198754"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/confirmBookingButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#198754"
            android:text="Confirm Booking Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
