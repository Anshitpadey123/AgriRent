<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  Back to Equipment"
            android:textColor="#198754"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/detailEmoji"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#E1F0E3"
            android:gravity="center"
            android:text="🚜"
            android:textSize="90sp" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tractor"
            android:textColor="#183B25"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#DDF2E2"
            android:padding="8dp"
            android:text="Agricultural Machinery"
            android:textColor="#198754"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="₹1,200 / day"
            android:textColor="#198754"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="● Available for booking"
            android:textColor="#198754"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#DCE5DC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Equipment Information"
            android:textColor="#183B25"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="📍 Location: Mathura"
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:text="Equipment details will appear here."
            android:textColor="#555555"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bookingNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select your booking dates on the next screen."
            android:textColor="#777777"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bookEquipmentButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#198754"
            android:text="Book Equipment"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
